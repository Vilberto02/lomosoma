# Clave de API de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini a utilizar, sino probar con gemini-flash-latest para utilizar el modelo vigente de Gemini.
GEMINI_MODEL=gemini-2.5-flash

# Modo Mock Offline: true = usar fallbacks locales sin llamar a la API
USE_MOCK_LLM=true

# Parámetros del Algoritmo Genético por defecto
AG_POBLACION_TAMANO=50
AG_GENERACIONES=100
AG_PROB_CRUCE=0.85
AG_PROB_MUTACION=0.15
AG_ELITISMO=2
